{
  "lexicon": 1,
  "id": "com.suibari.nagi.putDraft",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "#draftInput" }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "#draftView" }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "InvalidRequest" },
        { "name": "DraftLimit" }
      ]
    },
    "draftInput": {
      "type": "object",
      "required": ["id", "content", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "maxLength": 36 },
        "content": { "type": "ref", "ref": "#draftContent" },
        "createdAt": { "type": "string", "format": "datetime" },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    },
    "draftContent": {
      "type": "object",
      "required": [
        "text",
        "mentions",
        "channels",
        "emojis",
        "linkCards",
        "dismissedUrls"
      ],
      "properties": {
        "text": { "type": "string", "maxLength": 30000, "maxGraphemes": 3000 },
        "mentions": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#mention" }
        },
        "channels": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#channel" }
        },
        "emojis": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#emoji" }
        },
        "linkCards": {
          "type": "array",
          "maxLength": 4,
          "items": { "type": "ref", "ref": "#linkCard" }
        },
        "dismissedUrls": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "string", "maxLength": 2048 }
        },
        "quoteUri": { "type": "string", "format": "at-uri", "maxLength": 2048 }
      }
    },
    "mention": {
      "type": "object",
      "required": ["start", "end", "did", "handle"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" }
      }
    },
    "channel": {
      "type": "object",
      "required": ["start", "end", "uri", "name"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "uri": { "type": "string", "format": "at-uri", "maxLength": 2048 },
        "name": { "type": "string", "maxLength": 300 }
      }
    },
    "emoji": {
      "type": "object",
      "required": ["start", "end", "uri"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "uri": { "type": "string", "format": "at-uri", "maxLength": 2048 }
      }
    },
    "linkCard": {
      "type": "object",
      "required": ["uri", "title"],
      "properties": {
        "uri": { "type": "string", "maxLength": 2048 },
        "title": { "type": "string", "maxLength": 3000 },
        "description": { "type": "string", "maxLength": 30000 }
      }
    },
    "draftView": {
      "type": "object",
      "required": [
        "id",
        "text",
        "mentions",
        "channels",
        "emojis",
        "linkCards",
        "dismissedUrls",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "maxLength": 36 },
        "text": { "type": "string", "maxLength": 30000, "maxGraphemes": 3000 },
        "mentions": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#mention" }
        },
        "channels": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#channel" }
        },
        "emojis": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#emoji" }
        },
        "linkCards": {
          "type": "array",
          "maxLength": 4,
          "items": { "type": "ref", "ref": "#linkCard" }
        },
        "dismissedUrls": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "string", "maxLength": 2048 }
        },
        "quoteUri": { "type": "string", "format": "at-uri", "maxLength": 2048 },
        "createdAt": { "type": "string", "format": "datetime" },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
