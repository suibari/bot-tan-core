{
  "lexicon": 1,
  "id": "com.suibari.nagi.putPreferences",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "同期対象の本人設定を書き込む。既読位置は単調マージ、配列・言語・コンテンツ表示設定・通知設定・最後のブックマークフォルダは updatedAt による後勝ち。各項目は省略でき、送った分だけを更新する。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "detectedTimezone": {
              "type": "string",
              "maxLength": 64,
              "description": "Nagi を開いたときにブラウザが検出したタイムゾーン（IANA 名）。手動で選んでいる間は送らない。UTC や Etc/* は受け取っても使わない。"
            },
            "diaryDay": {
              "type": "object",
              "description": "日記の1日の区切り。送った項目だけを変える。",
              "properties": {
                "timezone": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "手動のタイムゾーン。null を送ると自動検出に戻す。"
                },
                "startHour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23,
                  "description": "区切りの時刻（18〜23, 0〜6）。"
                }
              }
            },
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。送らなければ変更しない。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。空文字を送ると登録を解除し、表示名に戻す。送らなければ変更しない。"
            },
            "chronicleReadYears": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "ref", "ref": "com.suibari.nagi.getChronicle#readYear" },
              "description": "年ごとの既読ハッシュ。過去の版は蓄積せず、現在の年表内容と一致する版だけを保存する。"
            },
            "adventRead": {
              "type": "object",
              "required": ["year"],
              "properties": {
                "year": { "type": "integer" },
                "lastSeenDay": { "type": "integer", "minimum": 0, "maximum": 25 },
                "openedDay": { "type": "integer", "minimum": 1, "maximum": 25 }
              },
              "description": "送った項目だけを進める。既読の日は戻らず、開封済みの日は消えない。"
            },
            "readPositions": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#readPosition"
              }
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" }
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "emojiFavorites を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#feedTab"
              }
            },
            "feedTabsUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "feedTabs を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "tagFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "string", "maxLength": 64 }
            },
            "tagFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "tagFavorites を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "languagePreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "moderationPreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#moderationPreferences"
            },
            "moderationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "notificationPreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#notificationPreferences",
              "description": "全カテゴリ分を丸ごと置き換える。"
            },
            "notificationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "notificationPreferences を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "lastBookmarkFolderId": {
              "type": "string",
              "maxLength": 64,
              "nullable": true
            },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readPositions", "emojiFavorites"],
          "properties": {
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。省略時は未設定＝表示名で呼ばれる。"
            },
            "chronicleReadYears": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.suibari.nagi.getChronicle#readYear" },
              "description": "年ごとの既読ハッシュ。過去の版は蓄積せず、現在の年表内容と一致する版だけを保存する。"
            },
            "adventRead": { "type": "ref", "ref": "com.suibari.nagi.getPreferences#adventRead" },
            "readPositions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#readPosition"
              },
              "description": "マージ後の確定値。送った位置が負けた場合は保存済みの方が返る。"
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" }
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#feedTab"
              }
            },
            "feedTabsUpdatedAt": { "type": "string", "format": "datetime" },
            "tagFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "string", "maxLength": 64 }
            },
            "tagFavoritesUpdatedAt": { "type": "string", "format": "datetime" },
            "languagePreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "moderationPreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#moderationPreferences"
            },
            "moderationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "notificationPreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#notificationPreferences"
            },
            "notificationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "lastBookmarkFolderId": { "type": "string", "maxLength": 64 },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "InvalidRequest" }
      ]
    }
  }
}
