{
  "lexicon": 1,
  "id": "com.suibari.nagi.getPreferences",
  "defs": {
    "main": {
      "type": "query",
      "description": "端末をまたいで同期する本人の設定（既読位置、お気に入り絵文字、フィードタブ、投稿・翻訳言語、コンテンツ表示、通知、最後のブックマークフォルダ）を返す。他ユーザーからは参照できない。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readPositions", "emojiFavorites"],
          "properties": {
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。Bluesky側のfreq設定と共用。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。省略時は未設定＝表示名で呼ばれる。"
            },
            "chronicleReadYears": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.suibari.nagi.getChronicle#readYear" },
              "description": "年ごとの既読ハッシュ。過去の版は蓄積せず、現在の年表内容と一致する版だけを保存する。"
            },
            "adventRead": {
              "type": "ref",
              "ref": "#adventRead",
              "description": "今年のアドベントカレンダーの既読と、開封演出を見終えた自分のカードの日。"
            },
            "readPositions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#readPosition" }
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" },
              "description": "お気に入り絵文字パレット。表示順そのまま。要素は #unicodeFavorite または #customFavorite。"
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者のお気に入りがまだ一度も同期されていないことを表す。"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": { "type": "ref", "ref": "#feedTab" },
              "description": "フィードのタブ。表示順そのまま。"
            },
            "feedTabsUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者がまだ一度もタブをカスタムしていないことを表す（クライアントは既定タブを使う）。"
            },
            "tagFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "string", "maxLength": 64 },
              "description": "お気に入りタグ。# を除いた小文字の正規形で、表示順そのまま。"
            },
            "tagFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者のお気に入りタグがまだ一度も同期されていないことを表す。"
            },
            "languagePreferences": {
              "type": "ref",
              "ref": "#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "moderationPreferences": {
              "type": "ref",
              "ref": "#moderationPreferences"
            },
            "moderationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "notificationPreferences": {
              "type": "ref",
              "ref": "#notificationPreferences"
            },
            "notificationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者がまだ一度も通知設定を保存していないことを表す（すべて既定）。"
            },
            "lastBookmarkFolderId": { "type": "string", "maxLength": 64 },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "diaryDay": { "type": "ref", "ref": "#diaryDay" }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }]
    },
    "diaryDay": {
      "type": "object",
      "description": "日記の「1日」を決める設定。本人にだけ返す。PDS レコードには書かない。",
      "required": ["startHour", "current"],
      "properties": {
        "detectedTimezone": {
          "type": "string",
          "maxLength": 64,
          "description": "Nagi を開いたときにブラウザから届いたタイムゾーン。"
        },
        "manualTimezone": {
          "type": "string",
          "maxLength": 64,
          "description": "本人が選んだタイムゾーン。あれば自動検出より優先する。"
        },
        "startHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "本人が選んだ区切りの時刻（18〜23, 0〜6）。既定は22。"
        },
        "current": { "type": "ref", "ref": "#diaryDayCurrent" },
        "pending": { "type": "ref", "ref": "#diaryDayPending" }
      }
    },
    "diaryDayCurrent": {
      "type": "object",
      "description": "今開いている日に使っている設定。effectiveFrom はその設定が有効になった日（言語からの推定のままなら省略）。",
      "required": ["timezone", "startHour"],
      "properties": {
        "timezone": { "type": "string", "maxLength": 64 },
        "startHour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "effectiveFrom": { "type": "string", "maxLength": 10 }
      }
    },
    "diaryDayPending": {
      "type": "object",
      "description": "まだ有効になっていない変更。effectiveFrom の日の日記から反映される。",
      "required": ["timezone", "startHour", "effectiveFrom"],
      "properties": {
        "timezone": { "type": "string", "maxLength": 64 },
        "startHour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "effectiveFrom": { "type": "string", "maxLength": 10 }
      }
    },
    "feedTab": {
      "type": "object",
      "description": "フィードのタブ1枚。必要なフィールドは kind ごとに異なる（list / custom は source、hashtag / search は query、bsky は uri または source=following）。",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "kind": {
          "type": "string",
          "knownValues": ["list", "global", "custom", "hashtag", "search", "bsky"],
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "knownValues": ["home", "affirmation", "following"],
          "maxLength": 32,
          "description": "kind が list / custom のときの参照先（list=home, custom=affirmation）。kind が bsky のときは following（Bluesky のホームタイムライン）だけを取り、uri と排他。"
        },
        "query": {
          "type": "string",
          "maxLength": 128,
          "description": "kind が search のときは自由文の保存クエリ、hashtag のときはタグ（先頭の # を除いた小文字）。"
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "maxLength": 512,
          "description": "kind が bsky のときの app.bsky.feed.generator の AT-URI。source が following なら持たない。"
        },
        "label": {
          "type": "string",
          "maxLength": 64,
          "description": "表示名のスナップショット。権威は query / uri 側。"
        }
      }
    },
    "languagePreferences": {
      "type": "object",
      "required": ["post", "translation", "provider", "autoTranslate"],
      "properties": {
        "post": { "type": "string", "maxLength": 16 },
        "translation": { "type": "string", "maxLength": 16 },
        "provider": {
          "type": "string",
          "knownValues": ["kagi", "deepl", "google"]
        },
        "autoTranslate": { "type": "boolean" }
      }
    },
    "moderationPreferences": {
      "type": "object",
      "required": ["automatic", "selfAi", "selfNsfw"],
      "properties": {
        "automatic": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        },
        "selfAi": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        },
        "selfNsfw": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        }
      }
    },
    "notificationPreferences": {
      "type": "object",
      "description": "通知の種別ごとの設定。Bluesky の app.bsky.notification.defs#preferences に倣う。省略したカテゴリは list / push とも true。botInteraction は botたんからの返信・メンション・リアクション（その3種別では人からのものと分けて扱う）。seasonal は季節の特別なお知らせ（アドベントカレンダーなど期間限定の催し）。",
      "properties": {
        "reply": { "type": "ref", "ref": "#notificationPreference" },
        "mention": { "type": "ref", "ref": "#notificationPreference" },
        "reaction": { "type": "ref", "ref": "#notificationPreference" },
        "botInteraction": { "type": "ref", "ref": "#notificationPreference" },
        "diary": { "type": "ref", "ref": "#notificationPreference" },
        "analysis": { "type": "ref", "ref": "#notificationPreference" },
        "chronicle": { "type": "ref", "ref": "#notificationPreference" },
        "mood": { "type": "ref", "ref": "#notificationPreference" },
        "gift": { "type": "ref", "ref": "#notificationPreference" },
        "seasonal": { "type": "ref", "ref": "#notificationPreference" }
      }
    },
    "notificationPreference": {
      "type": "object",
      "description": "list は通知欄に出すか、push はプッシュ通知するか。",
      "required": ["list", "push"],
      "properties": {
        "list": { "type": "boolean" },
        "push": { "type": "boolean" }
      }
    },
    "adventRead": {
      "type": "object",
      "required": ["year", "lastSeenDay", "openedDays"],
      "properties": {
        "year": { "type": "integer" },
        "lastSeenDay": { "type": "integer", "minimum": 0, "maximum": 25 },
        "openedDays": { "type": "array", "maxLength": 25, "items": { "type": "integer" } }
      }
    },
    "readPosition": {
      "type": "object",
      "description": "「ここまで読んだ」位置。新旧の比較は (indexedAt, uri) の辞書順で行う。",
      "required": ["section", "indexedAt", "uri"],
      "properties": {
        "section": {
          "type": "string",
          "knownValues": ["bot", "community", "list", "channels", "news"],
          "maxLength": 32
        },
        "indexedAt": { "type": "string", "format": "datetime" },
        "uri": { "type": "string", "format": "at-uri", "maxLength": 2048 }
      }
    },
    "unicodeFavorite": {
      "type": "object",
      "required": ["kind", "emoji"],
      "properties": {
        "kind": { "type": "string", "const": "unicode" },
        "emoji": { "type": "string", "maxLength": 64 }
      }
    },
    "customFavorite": {
      "type": "object",
      "description": "Bluemoji のスナップショット。url などは表示のたびに再解決されるので、権威は uri のみ。",
      "required": ["kind", "emoji"],
      "properties": {
        "kind": { "type": "string", "const": "custom" },
        "emoji": { "type": "unknown" }
      }
    }
  }
}
