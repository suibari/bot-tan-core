{
  "lexicon": 1,
  "id": "com.suibari.nagi.getSimilarNews",
  "defs": {
    "main": {
      "type": "query",
      "description": "ニュースのパーマリンクに出す「似ているニュース」。基準記事の埋め込みに近い承認済みニュースを返す。",
      "parameters": {
        "type": "params",
        "required": ["rkey"],
        "properties": {
          "rkey": { "type": "string", "maxLength": 32 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 10, "default": 4 },
          "lang": { "type": "string", "knownValues": ["ja", "en"], "default": "ja" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
