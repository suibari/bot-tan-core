{
  "lexicon": 1,
  "id": "com.suibari.nagi.getChannelTimeline",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string" },
          "filter": {
            "type": "string",
            "knownValues": ["posts", "media"],
            "default": "posts",
            "description": "media returns image-bearing posts one row each (no conversation grouping), for the media grid."
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "com.suibari.nagi.getTimeline#output" }
      }
    }
  }
}
