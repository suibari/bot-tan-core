{
  "lexicon": 1,
  "id": "com.suibari.nagi.putCommunityAffirmationDismissals",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uris"],
          "properties": {
            "uris": {
              "type": "array",
              "description": "Posts selected as private dismissal anchors. Each anchor also excludes similar community-affirmation candidates by the same author while active.",
              "maxLength": 200,
              "items": {
                "type": "string",
                "format": "at-uri",
                "maxLength": 2048
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accepted"],
          "properties": {
            "accepted": { "type": "integer", "minimum": 0, "maximum": 200 }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }, { "name": "InvalidRequest" }]
    }
  }
}
