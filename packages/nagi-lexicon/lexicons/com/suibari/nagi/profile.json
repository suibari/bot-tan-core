{
  "lexicon": 1,
  "id": "com.suibari.nagi.profile",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["displayName", "createdAt"],
        "properties": {
          "displayName": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
          "description": { "type": "string", "maxGraphemes": 256, "maxLength": 2560 },
          "website": { "type": "string", "maxLength": 2048 },
          "avatar": {
            "type": "blob",
            "accept": ["image/jpeg", "image/png", "image/webp"],
            "maxSize": 1000000
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
