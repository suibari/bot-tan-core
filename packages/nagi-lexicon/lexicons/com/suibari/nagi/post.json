{
  "lexicon": 1,
  "id": "com.suibari.nagi.post",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": { "type": "string", "maxGraphemes": 3000, "maxLength": 30000 },
          "facets": {
            "type": "array",
            "items": { "type": "ref", "ref": "app.bsky.richtext.facet" }
          },
          "langs": {
            "type": "array",
            "maxLength": 3,
            "items": { "type": "string", "format": "language" }
          },
          "labels": { "type": "ref", "ref": "com.atproto.label.defs#selfLabels" },
          "createdAt": { "type": "string", "format": "datetime" },
          "cwRestricted": { "type": "boolean" },
          "kossori": { "type": "boolean" },
          "botSilent": { "type": "boolean" },
          "silentReply": {
            "type": "boolean",
            "description": "true の返信は直接の返信先へ通知しない。返信以外では効果を持たない。"
          },
          "channel": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "reply": { "type": "ref", "ref": "#replyRef" },
          "linkCards": {
            "type": "array",
            "maxLength": 4,
            "items": { "type": "ref", "ref": "#linkCard" }
          },
          "embed": { "type": "union", "refs": ["#images", "#video", "#gallery", "#quote"] }
        }
      }
    },
    "linkCard": {
      "type": "object",
      "required": ["uri", "title"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "title": { "type": "string", "maxGraphemes": 300, "maxLength": 3000 },
        "description": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 },
        "thumb": {
          "type": "blob",
          "accept": ["image/jpeg", "image/png", "image/webp"],
          "maxSize": 1000000
        }
      }
    },
    "replyRef": {
      "type": "object",
      "required": ["root", "parent"],
      "properties": {
        "root": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "parent": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "images": {
      "type": "object",
      "required": ["images"],
      "properties": {
        "images": {
          "type": "array",
          "minLength": 1,
          "maxLength": 4,
          "items": { "type": "ref", "ref": "#image" }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "type": "blob",
          "accept": ["image/jpeg", "image/png", "image/webp", "image/gif"],
          "maxSize": 2000000
        },
        "alt": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 },
        "contentWarning": { "type": "boolean" },
        "aspectRatio": { "type": "ref", "ref": "app.bsky.embed.defs#aspectRatio" }
      }
    },
    "video": {
      "type": "object",
      "required": ["video"],
      "description": "video.bsky.app で変換した mp4。再生は同サービスの HLS を使う。",
      "properties": {
        "video": {
          "type": "blob",
          "accept": ["video/mp4"],
          "maxSize": 100000000
        },
        "alt": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 },
        "contentWarning": { "type": "boolean" },
        "aspectRatio": { "type": "ref", "ref": "app.bsky.embed.defs#aspectRatio" }
      }
    },
    "gallery": {
      "type": "object",
      "required": ["items"],
      "description": "画像と動画を1投稿に混ぜるための embed。app.bsky.embed.gallery と同じく型付き item の union 配列で持つ。現状は画像4枚・動画1本まで。順序はレコードに残すが、ビューは画像→動画の順で返す。画像だけ・動画だけの投稿は #images / #video を使う。",
      "properties": {
        "items": {
          "type": "array",
          "minLength": 1,
          "maxLength": 5,
          "items": { "type": "union", "refs": ["#image", "#video"] }
        }
      }
    },
    "quote": {
      "type": "object",
      "required": ["record"],
      "properties": {
        "record": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "images": {
          "type": "array",
          "minLength": 1,
          "maxLength": 4,
          "items": { "type": "ref", "ref": "#image" }
        },
        "video": {
          "type": "ref",
          "ref": "#video",
          "description": "images と併用できる（画像4枚＋動画1本まで）。引用付きで画像と動画を混ぜるときは #gallery ではなくここに持つ。"
        }
      }
    }
  }
}
