{
  "name": "biorhythm-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "whimsical:news:preview": "tsx --env-file=../../.env src/whimsicalPostPreview.ts",
    "status:preview": "tsx --env-file=../../.env src/statusPreview.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.21",
    "@bsky-affirmative-bot/bot-brain": "workspace:*",
    "@bsky-affirmative-bot/bot-runtime": "workspace:*",
    "@bsky-affirmative-bot/clients": "workspace:*",
    "@bsky-affirmative-bot/database": "workspace:*",
    "@bsky-affirmative-bot/shared-configs": "workspace:*",
    "@google/genai": "^1.41.0",
    "@types/async-retry": "^1.4.9",
    "async-retry": "^1.3.3",
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "express": "^5.0.0",
    "ts-node": "^10.9.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
