{
  "lexicon": 1,
  "id": "com.suibari.nagi.getRadioTrack",
  "defs": {
    "main": {
      "type": "query",
      "description": "認証した本人の現在のbotたんラジオ曲と未読状態。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "hasUnread": {
              "type": "boolean"
            },
            "track": {
              "type": "ref",
              "ref": "#track"
            }
          },
          "required": [
            "hasUnread"
          ]
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "slotKey",
        "title",
        "artist",
        "comment",
        "publishedAt",
        "songUrl",
        "thumbnailUrl"
      ],
      "properties": {
        "slotKey": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "commentJa": {
          "type": "string"
        },
        "commentEn": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "datetime"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "songUrl": {
          "type": "string",
          "format": "uri",
          "description": "選曲した曲のページ。Last.fmまたは既存のYouTubeリンク。"
        },
        "thumbnailUrl": {
          "type": "string",
          "format": "uri",
          "description": "曲のジャケット画像。既存のYouTube履歴では動画サムネイル。"
        }
      }
    }
  }
}
