# searxng/compose.yml 用。docker compose がこのディレクトリの .env を自動で読む。
# （リポジトリルートの .env とは別物。bot 側が使う SEARXNG_BASE_URL はそちらに書く）

# 必須。`openssl rand -hex 32` で生成する。
SEARXNG_SECRET=

# 共通出口APIの認証キー。openssl rand -hex 32 で生成し、利用側のSEARXNG_API_KEYと揃える。
SEARCH_GATEWAY_API_KEY=
# 本番は192.168.1.200。SearXNG本体のポートは公開しない。
SEARCH_GATEWAY_BIND=127.0.0.1

# 共通出口APIの待ち受けポート。利用側のSEARXNG_BASE_URLと揃えること。
SEARXNG_PORT=8080
