# Zenkoutei Bot-tan development environment
#
# Copy this file to .env and fill in only the groups needed by the services
# you run. Empty values below are secrets or deployment-specific identifiers.
# Never commit .env, service-account.json, app passwords, signing keys, or tokens.

# -----------------------------------------------------------------------------
# Common runtime and database
# -----------------------------------------------------------------------------

NODE_ENV=development
TZ=Asia/Tokyo
# Matches compose.dev.yml. The development fixture command refuses any database
# host/name other than a loopback nagi_dev database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/nagi_dev
# Jetstream endpoints for the Bluesky and Nagi bots. Comma-separated candidates:
# when a connection stays down for ~20s the consumer moves to the next one, so
# list more than one to survive a bad host. Point the first entry at the local
# JetstreamProxy to keep sharing one upstream connection between the bots.
URL_JETSTREAM=wss://jetstream1.us-east.bsky.network/subscribe,wss://jetstream2.us-east.bsky.network/subscribe,wss://jetstream1.us-west.bsky.network/subscribe,wss://jetstream2.us-west.bsky.network/subscribe
# Jetstream endpoints for the AppView. Kept separate from URL_JETSTREAM because
# every process loads this same .env: the AppView restores its saved cursor on
# every connect, and JetstreamProxy does not forward a client cursor upstream,
# so the AppView must talk to instances that honour it. Defaults to the four
# official instances. Cursors are time-based and shared across them, so failing
# over between them is lossless.
URL_JETSTREAM_APPVIEW=wss://jetstream1.us-east.bsky.network/subscribe,wss://jetstream2.us-east.bsky.network/subscribe,wss://jetstream1.us-west.bsky.network/subscribe,wss://jetstream2.us-west.bsky.network/subscribe
# Shared template selection for Bluesky and Nagi: random (default) or llm.
PREDEFINED_REPLY_SELECTOR=random
# Deprecated compatibility alias used only when PREDEFINED_REPLY_SELECTOR is unset.
# BSKY_PREDEFINED_SELECTOR=random

# Optional operator identity used by development/admin paths.
DEVELOPER_DID=

# -----------------------------------------------------------------------------
# Bluesky Bot-tan (apps/bsky_bot_server)
# -----------------------------------------------------------------------------

# Required: Bot-tan's DID and an AT Protocol app password.
BSKY_DID=
BSKY_APP_PASSWORD=

BSKY_BOT_SERVER_PORT=3001
BSKY_BOT_SERVER_URL=http://127.0.0.1:3001

# Optional integrations used by individual Bluesky features.
NEGAPOSI_URL=
ROOM_SERVER_URL=
ROOM_SERVER_SECRET=
ROOM_PAGE_URL=http://localhost:5174

# -----------------------------------------------------------------------------
# Nagi Bot-tan (apps/nagi_bot_server)
# -----------------------------------------------------------------------------

# Required: Nagi Bot-tan's DID and AT Protocol app password.
NAGI_BOT_DID=
NAGI_BOT_APP_PASSWORD=

NAGI_BOT_SERVER_PORT=3003
NAGI_BOT_SERVER_URL=http://127.0.0.1:3003
NAGI_APPVIEW_INTERNAL_URL=http://127.0.0.1:3005

# Optional feature and cost controls. Values shown are the code defaults.
NAGI_AI_USER_10M_LIMIT=10
NAGI_AI_USER_24H_LIMIT=60
NAGI_AI_SERVICE_10M_LIMIT=300
NAGI_AI_SERVICE_24H_LIMIT=2000
NAGI_CHANNEL_DORMANT_HOURS=168
NAGI_CHANNEL_SCAN_INTERVAL_MS=21600000

# -----------------------------------------------------------------------------
# Nagi AppView (apps/nagi_appview)
# -----------------------------------------------------------------------------

# Public and loopback-only listeners. These sample ports avoid collisions with
# the other services in this monorepo.
NAGI_PORT=3004
NAGI_HOST=127.0.0.1
NAGI_APPVIEW_INTERNAL_PORT=3005
# Comma-separated browser origins allowed to call AppView directly.
# Production example:
# NAGI_CLIENT_ORIGIN=https://nagi.suibari.com,https://nagi-client-git-develop-suibaris-projects.vercel.app
NAGI_CLIENT_ORIGIN=http://localhost:5173

# Required for service-auth and indexing. Use your own did:web or did:plc.
NAGI_APPVIEW_DID=

NAGI_JETSTREAM_REPLAY_SECONDS=60
NAGI_RECONCILE_INTERVAL_MINUTES=360
NAGI_RECONCILE_CONCURRENCY=2
NAGI_EMOJI_ASSET_RATE_LIMIT=1200
NAGI_AFFIRMATION_THRESHOLD=86
# Deprecated compatibility alias; prefer NAGI_AFFIRMATION_THRESHOLD.
# NAGI_TREND_THRESHOLD=86
NAGI_USER_NEWS_DAILY_LIMIT=3
TRANSLATION_CONCURRENCY=2
TRANSLATION_MISS_LIMIT_PER_MINUTE=60

# Development-only authentication bypass. It is effective only in the
# development environment. Keep false unless you specifically need local viewer
# simulation.
APPVIEW_DEV_TRUST_VIEWER=false

# Semantic-search tuning. The values below are the measured defaults from the
# 2026-09-04 embedding evaluation (docs/evaluations/embedding/summary.md).
# Leave blank to fall back to the code defaults, but note those predate the
# evaluation and score materially worse (nDCG@10 0.366 vs 0.548).
#
# OLLAMA_QUERY_PREFIX and the distance limits MUST be changed together: the
# query prefix shifts the whole cosine-distance scale up by about +0.19, so a
# prefix with the old 0.65 limit silently cuts most real hits.
# The distance limits do NOT separate relevant from irrelevant hits (measured:
# relevant p50 0.666 vs irrelevant p50 0.707) — set them so nothing relevant is
# lost. Result quality comes from the model and SEMANTIC_LIMIT, not from these.
#
# The values below are for OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b. Each model has
# its own distance scale, so changing the model means re-measuring all four.
# For snowflake-arctic-embed2 the measured set is:
#   OLLAMA_QUERY_PREFIX="query: "
#   SEARCH_SEM_DIST_MAX=0.80  SEARCH_SEM_REL_MARGIN=0.12  SEARCH_ACTOR_SEM_DIST_MAX=0.95
#
# The prefix contains a newline. Quote it with DOUBLE quotes: both dotenv and
# `node --env-file` expand \n there (single quotes keep it literal). systemd
# Environment= and docker -e do not expand it, so searchQueryPrefix() expands a
# leftover \n as a fallback.
OLLAMA_QUERY_PREFIX="Instruct: Given a search query, retrieve relevant social media posts written in Japanese\nQuery: "
SEARCH_SEM_DIST_MAX=0.60
SEARCH_SEM_REL_MARGIN=0.08
# Profiles are short text and sit further away, so this stays SEM_DIST_MAX + 0.15.
SEARCH_ACTOR_SEM_DIST_MAX=0.75

# Optional SSO ticket issuing for Bot-tan's Room. PASSPORT_PRIVATE_JWK must be a
# compact JSON object on one line. If omitted, SSO issuing is disabled.
PASSPORT_PRIVATE_JWK=
PASSPORT_ISSUER=http://localhost:3004
PASSPORT_AUDIENCES=http://localhost:5174
PASSPORT_TTL_SECONDS=60

# Optional Web Push. Both keys are required to enable push delivery. The
# Firebase Admin credential is not an env var in this repository: place the
# local service-account.json only when testing FCM, and never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------------------
# Biorhythm and shared scheduled posts (apps/biorhythm_server)
# -----------------------------------------------------------------------------

BIORHYTHM_SERVER_PORT=3002
BIORHYTHM_SERVER_HOST=127.0.0.1
BIORHYTHM_SERVER_URL=http://127.0.0.1:3002

# Required when callers use the internal API.
BIORHYTHM_INTERNAL_SECRET=

# RAG memory API has a dedicated listener and is never mounted on the public
# HTTP/WebSocket server above. Keep loopback for local-only use. In production,
# bind this host to the server's LAN address and allow only the YouTube host in UFW.
BIORHYTHM_MEMORY_API_HOST=127.0.0.1
BIORHYTHM_MEMORY_API_PORT=3003

# bottan_live.comments の新規コメントを energy に反映する。
# energy は内部で100倍値のため、10は画面表示上の +0.1。
BIORHYTHM_LIVE_COMMENT_POLL_INTERVAL_MS=15000
BIORHYTHM_LIVE_COMMENT_ENERGY=10

# In production this complete-match allowlist is required. Comma-separate each
# browser origin that may open the public WebSocket.
BIORHYTHM_WS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5174
BIORHYTHM_WS_MAX_CONNECTIONS=500
BIORHYTHM_WS_MAX_CONNECTIONS_PER_IP=10
BIORHYTHM_WS_MAX_BUFFERED_BYTES=1048576
BIORHYTHM_WS_HEARTBEAT_INTERVAL_MS=30000
BIORHYTHM_WS_SNAPSHOT_TTL_MS=5000

# Trust this header only when direct access to the origin server is blocked.
BIORHYTHM_TRUST_CF_CONNECTING_IP=false

# Valid targets: bsky, nagi. Valid top-post sources: bsky, nagi, combined.
SCHEDULED_POST_TARGETS=bsky,nagi
GOOD_NIGHT_TOP_POST_SOURCE=combined

# One-off status preview switch; normally prefer the --fresh CLI flag.
PLAN_REFRESH=0

# -----------------------------------------------------------------------------
# Bluesky labeler (apps/labeler_server)
# -----------------------------------------------------------------------------

# Required.
LABELER_DID=
LABELER_SIGNING_KEY=

# Required only for label publication/login operations.
LABELER_PASSWORD=

LABELER_DB_PATH=./labels.db
LABELER_SERVER_PORT=3400
LABELER_INTERNAL_PORT=3401
LABELER_SERVER_URL=http://127.0.0.1:3400
LABELER_PUBLIC_URL=http://127.0.0.1:3400
LABELER_INTERNAL_URL=http://127.0.0.1:3401

# -----------------------------------------------------------------------------
# Nagi moderation (apps/nagi_appview)
# -----------------------------------------------------------------------------

# 公開されるユーザー生成物を OpenAI omni-moderation で判定する。未設定なら判定機能
# ごと無効（取り込み・投稿は動くが、レコードは判定待ちのまま残る）。本番では必須。
OPENAI_API_KEY=

# 判定結果の通知先 Discord チャンネル Webhook。未設定なら通知しない。
NAGI_MODERATION_DISCORD_WEBHOOK_URL=

# OpenAI が画像を取りに来る先。既定は NAGI_APPVIEW_DID(did:web) から導出するので、
# did:web 以外を使うときだけ設定する。
# NAGI_APPVIEW_PUBLIC_URL=https://nagi-api.suibari.com

# -----------------------------------------------------------------------------
# Discord integration (apps/discord_bot)
# -----------------------------------------------------------------------------

DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
DISCORD_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Local and cloud AI
# -----------------------------------------------------------------------------

# Grounding no longer uses Gemini: search runs on the self-hosted SearXNG below and
# page bodies are fetched locally. This key is only needed for image generation
# (currently unreferenced) and for rolling back with AI_TEXT_PROVIDER=gemini.
# A normal ollama deployment never constructs the Google client, so leaving this
# empty is fine.
GEMINI_API_KEY=

# Ollama's base URL keeps the OpenAI-compatible /v1 suffix. Text generation strips it and
# uses the native /api/chat endpoint, which is the only way to set think:false; embeddings
# and the health probe stay on /v1. No local call sends num_ctx -- the server's
# OLLAMA_CONTEXT_LENGTH is the single source of truth (see AGENTS.md).
AI_TEXT_PROVIDER=ollama
AI_GROUNDING_PROVIDER=searxng            # searxng | off
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-IQ3_S
OLLAMA_TEXT_TIMEOUT_MS=180000
# プロンプト予算の計算が前提にする num_ctx。**リクエストには載らない**（Ollama へ num_ctx
# は送らない。サーバの OLLAMA_CONTEXT_LENGTH が唯一の源）。未設定なら 32768。
# ホストの VRAM が足りない（ollama ps の PROCESSOR が 100% GPU から落ちる）ときは、
# **まず systemd の OLLAMA_CONTEXT_LENGTH を下げ、それから**ここを同じ値へ合わせる。
# 順序を逆にすると予算計算だけが小さくなり、プロンプトが無駄に切り詰められる。
# ズレは biorhythm_server の健康監視が /api/ps と突き合わせて WARN を出す。
# OLLAMA_TEXT_CONTEXT_LENGTH=16384
# 埋め込みモデル。2026-09-04 の評価で arctic-embed2 から差し替えた
# （nDCG@10 0.366 → 0.639、固有名詞 0.214 → 0.458。docs/evaluations/embedding/）。
# どちらも 1024次元なのでスキーマ変更は不要だが、モデルを変えたら
# SEARCH_SEM_DIST_MAX 系と OLLAMA_QUERY_PREFIX を必ず測り直すこと（距離スケールが違う）。
# 全件再埋め込み: npx tsx --env-file=.env scripts/reembedAll.mts --run
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# 埋め込みを別Ollamaへ分離するときだけ設定。未設定なら OLLAMA_BASE_URL を使う。
# OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11435/v1
# 返信前の関連履歴検索を長時間止めない。失敗後は一定時間、即座に履歴フォールバックする。
OLLAMA_EMBED_TIMEOUT_MS=5000
OLLAMA_EMBED_COOLDOWN_MS=60000
OLLAMA_TRANSLATION_MODEL=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-IQ3_S
OLLAMA_BOT_TRANSLATION_MODEL=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-IQ3_S

# 自前ホストの SearXNG（grounding の検索段）。bot 機に同居させ、searxng/compose.yml で
# loopback に固定して立てる（Ollama は LLM 機、SearXNG は bot 機。別サービスなので
# OLLAMA_BASE_URL とは無関係。/v1 も付けない）。
# 自分の検索基盤なので、この URL は SSRF 検証（nagi-linkcard の safeUrl）に通しては
# いけない。ループバック / RFC1918 が遮断されて自分自身へ届かなくなる。
SEARXNG_BASE_URL=http://127.0.0.1:8080
# 使うエンジン。bing=一覧と時事の索引、wikipedia/wikidata=固有名詞の実在確認（infobox）。
# google と duckduckgo は自前インスタンスに CAPTCHA を返すので入れない（実測済み）。
SEARXNG_ENGINES=bing,wikipedia,wikidata
# 1クエリあたりの採用件数。1〜10 にクランプされる。
SEARXNG_MAX_RESULTS=5
SEARXNG_TIMEOUT_MS=15000

# Optional model alias overrides. Uncomment only when you intend to replace a
# registry default from packages/shared-configs/src/config/aiRoutes.ts.
# MODEL_GEMINI_LITE=gemini-2.5-flash-lite
# MODEL_GEMINI_FLASH=gemini-2.5-flash
# MODEL_GEMINI_35_LITE=gemini-3.5-flash-lite
# MODEL_GEMINI_36_FLASH=gemini-3.6-flash
# MODEL_GEMINI_IMAGE=gemini-2.5-flash-image-preview

# Advanced per-feature routing. Valid values are defined by AI_ROUTES in
# packages/shared-configs/src/config/aiRoutes.ts. The commented values below
# document current defaults; leaving them unset is recommended.
# AI_ROUTE_COMMON_USER_DIARY=35-lite-flex
# AI_ROUTE_COMMON_DIARY_ATTEMPT_EARLY=35-lite-flex
# AI_ROUTE_COMMON_DIARY_ATTEMPT_MID=35-lite-standard
# AI_ROUTE_COMMON_DIARY_ATTEMPT_LATE=35-lite-standard
# AI_ROUTE_BSKY_AFFIRMATIVE_REPLY=lite-flex
# AI_ROUTE_BSKY_CONVERSATION=lite-flex
# AI_ROUTE_BSKY_ANALYZE=lite-flex
# AI_ROUTE_BSKY_FORTUNE=lite-flex
# AI_ROUTE_BSKY_BOT_DIARY=lite-flex
# AI_ROUTE_BSKY_QUESTIONS_ANSWER=lite-flex
# AI_ROUTE_BSKY_RECOMMENDED_SONG=lite-flex
# AI_ROUTE_BSKY_WHIMSICAL_REPLY=lite-flex
# AI_ROUTE_BSKY_CHEER_SUBJECT=lite-flex
# AI_ROUTE_BSKY_CHEER_RESULT=lite-flex
# AI_ROUTE_BSKY_OMIKUJI=lite-flex
# AI_ROUTE_BSKY_ANNIVERSARY=lite-flex
# AI_ROUTE_BSKY_RECAP=lite-flex
# AI_ROUTE_BSKY_ROOM_WELCOME=lite-flex
# AI_ROUTE_BSKY_MY_MOOD_SONG=lite-flex
# AI_ROUTE_BSKY_IMAGE=image-auto
# AI_ROUTE_BIORHYTHM_SEASONAL_WORKS=flash-flex
# AI_ROUTE_BIORHYTHM_DAILY_PLAN=flash-standard
# AI_ROUTE_BIORHYTHM_STATUS=flash-flex
# AI_ROUTE_BIORHYTHM_GOOD_NIGHT=flash-flex
# AI_ROUTE_BIORHYTHM_QUESTION=flash-flex
# AI_ROUTE_BIORHYTHM_WHIMSICAL_POST_PLAN=flash-flex
# AI_ROUTE_BIORHYTHM_WHIMSICAL_POST_WRITE=flash-flex
# AI_ROUTE_NAGI_REPLY_ATTEMPT_EARLY=lite-flex
# AI_ROUTE_NAGI_REPLY_ATTEMPT_MID=lite-standard
# AI_ROUTE_NAGI_REPLY_ATTEMPT_LATE=flash-standard
# AI_ROUTE_NAGI_ANALYSIS=lite-standard
# AI_ROUTE_NAGI_CARD_COMMENT=lite-standard
# AI_ROUTE_NAGI_COMMUNITY_AFFIRMATION=lite-flex
# AI_ROUTE_NAGI_CHANNEL_WELCOME=lite-flex
# AI_ROUTE_NAGI_CHANNEL_TOPIC=lite-flex
# AI_ROUTE_NAGI_NAME_INTENT=lite-flex
# AI_ROUTE_NEWS_POSITIVE_GATE=lite-flex
# AI_ROUTE_NEWS_POSITIVE_COMMENT=lite-flex
# AI_ROUTE_OLLAMA_PREDEFINED_AFFIRMATION=ollama-chat
# AI_ROUTE_OLLAMA_NEWS_PRESCREEN=ollama-chat
# AI_ROUTE_OLLAMA_EMBED=ollama-embed
# AI_ROUTE_OLLAMA_TRANSLATION=ollama-translate
# AI_ROUTE_OLLAMA_BOT_TRANSLATION=ollama-bot-translate
# AI_ROUTE_BIORHYTHM_STATUS=ollama-chat

# -----------------------------------------------------------------------------
# Optional external integrations
# -----------------------------------------------------------------------------

NEWSDATA_API_KEY=
YOUTUBE_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=

# Bot-tan diary publishing. Configure only the destinations you use.
LEAFLET_USERNAME=
LEAFLET_PUBLICATION_URL=
GITHUB_PAT=
GITHUB_DIARY_REPO=
GITHUB_DIARY_BRANCH=main
ZENN_USERNAME=
