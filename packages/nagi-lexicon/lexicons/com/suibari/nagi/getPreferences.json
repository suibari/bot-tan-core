{
  "lexicon": 1,
  "id": "com.suibari.nagi.getPreferences",
  "defs": {
    "main": {
      "type": "query",
      "description": "端末をまたいで同期する本人の設定（既読位置、お気に入り絵文字、フィードタブ、投稿・翻訳言語、コンテンツ表示、最後のブックマークフォルダ）を返す。他ユーザーからは参照できない。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readPositions", "emojiFavorites"],
          "properties": {
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。Bluesky側のfreq設定と共用。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。省略時は未設定＝表示名で呼ばれる。"
            },
            "readPositions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#readPosition" }
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" },
              "description": "お気に入り絵文字パレット。表示順そのまま。要素は #unicodeFavorite または #customFavorite。"
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者のお気に入りがまだ一度も同期されていないことを表す。"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": { "type": "ref", "ref": "#feedTab" },
              "description": "フィードのタブ。表示順そのまま。"
            },
            "feedTabsUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "省略時は、この利用者がまだ一度もタブをカスタムしていないことを表す（クライアントは既定タブを使う）。"
            },
            "languagePreferences": {
              "type": "ref",
              "ref": "#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "moderationPreferences": {
              "type": "ref",
              "ref": "#moderationPreferences"
            },
            "moderationPreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "lastBookmarkFolderId": { "type": "string", "maxLength": 64 },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }]
    },
    "feedTab": {
      "type": "object",
      "description": "フィードのタブ1枚。必要なフィールドは kind ごとに異なる（list / custom は source、channel は uri、search は query）。",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "kind": {
          "type": "string",
          "knownValues": ["list", "global", "custom", "channel", "search"],
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "knownValues": ["home", "affirmation"],
          "maxLength": 32,
          "description": "kind が list / custom のときの参照先（list=home, custom=affirmation）。将来のユーザー定義フィードは uri で指す。"
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "maxLength": 2048,
          "description": "kind が channel のときのチャンネル。"
        },
        "query": {
          "type": "string",
          "maxLength": 128,
          "description": "kind が search のときの保存クエリ。"
        },
        "queryKind": {
          "type": "string",
          "knownValues": ["keyword", "tag"],
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "maxLength": 64,
          "description": "表示名のスナップショット。権威は uri / query 側。"
        }
      }
    },
    "languagePreferences": {
      "type": "object",
      "required": ["post", "translation", "provider", "autoTranslate"],
      "properties": {
        "post": { "type": "string", "maxLength": 16 },
        "translation": { "type": "string", "maxLength": 16 },
        "provider": {
          "type": "string",
          "knownValues": ["kagi", "deepl", "google"]
        },
        "autoTranslate": { "type": "boolean" }
      }
    },
    "moderationPreferences": {
      "type": "object",
      "required": ["automatic", "selfAi", "selfNsfw"],
      "properties": {
        "automatic": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        },
        "selfAi": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        },
        "selfNsfw": {
          "type": "string",
          "knownValues": ["warn", "hide", "ignore"]
        }
      }
    },
    "readPosition": {
      "type": "object",
      "description": "「ここまで読んだ」位置。新旧の比較は (indexedAt, uri) の辞書順で行う。",
      "required": ["section", "indexedAt", "uri"],
      "properties": {
        "section": {
          "type": "string",
          "knownValues": ["bot", "community", "list", "channels", "news"],
          "maxLength": 32
        },
        "indexedAt": { "type": "string", "format": "datetime" },
        "uri": { "type": "string", "format": "at-uri", "maxLength": 2048 }
      }
    },
    "unicodeFavorite": {
      "type": "object",
      "required": ["kind", "emoji"],
      "properties": {
        "kind": { "type": "string", "const": "unicode" },
        "emoji": { "type": "string", "maxLength": 64 }
      }
    },
    "customFavorite": {
      "type": "object",
      "description": "Bluemoji のスナップショット。url などは表示のたびに再解決されるので、権威は uri のみ。",
      "required": ["kind", "emoji"],
      "properties": {
        "kind": { "type": "string", "const": "custom" },
        "emoji": { "type": "unknown" }
      }
    }
  }
}
