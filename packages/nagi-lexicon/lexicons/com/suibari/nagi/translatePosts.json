{
  "lexicon": 1,
  "id": "com.suibari.nagi.translatePosts",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uris", "targetLang"],
          "properties": {
            "uris": {
              "type": "array",
              "minLength": 1,
              "maxLength": 50,
              "items": { "type": "string", "format": "at-uri" },
              "description": "訳す対象。Nagi 投稿（com.suibari.nagi.post / site.standard.document）か、ゼンカツ提出（com.suibari.nagi.zenkatsu。訳すのは作者の意図 note で、判定済みのものだけ）。"
            },
            "targetLang": { "type": "string", "format": "language" },
            "cacheOnly": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["translations", "failures"],
          "properties": {
            "translations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uri", "text"],
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "text": { "type": "string" }
                }
              }
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uri", "code"],
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "code": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
