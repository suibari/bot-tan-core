      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string", "maxLength": 64 } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["deleted"],
          "properties": { "deleted": { "type": "boolean", "const": true } }
        }
      },
      "errors": [{ "name": "AuthRequired" }]
    }
  }
}
