{
  "lexicon": 1,
  "id": "com.suibari.nagi.getMutes",
  "defs": {
    "main": {
      "type": "query",
      "description": "自分がミュートしているユーザーとハッシュタグの一覧。ミュートは非公開情報なので、認証した本人の分だけを返す。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actors", "tags"],
          "properties": {
            "actors": { "type": "array", "items": { "type": "unknown" } },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }]
    }
  }
}
