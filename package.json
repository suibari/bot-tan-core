{
  "name": "bsky_affirmative_bot_monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:news": "tsx --test packages/bot_brain/test/newsdata.test.ts packages/bot_brain/test/positiveNewsSelection.test.ts apps/biorhythm_server/test/whimsicalPostNewsHistory.test.ts",
    "diary:model:evaluate": "tsx scripts/evaluateUserDiaryModels.ts",
    "bot-diary:evaluate": "tsx --env-file=.env scripts/evaluateBotDiary.mts",
    "predefined-reply:evaluate": "tsx --env-file=.env scripts/evaluatePredefinedReplies.ts",
    "local-model:evaluate": "tsx --env-file=.env scripts/evaluateLocalModels.mts",
    "ai-migration:evaluate": "tsx --env-file=.env scripts/evaluateMigratedAiFeatures.mts",
    "mood-song:lastfm:evaluate": "tsx --env-file=.env scripts/evaluateLastFmMoodSongs.mts",
    "embedding:evaluate": "tsx --env-file=.env scripts/evaluateEmbeddingModels.mts",
    "test:embedding": "tsx --test scripts/test/embeddingEvaluation.test.ts",
    "searxng:probe": "tsx --env-file=.env scripts/probeSearxng.mts",
    "reply:probe": "tsx --env-file=.env scripts/probeReply.mts",
    "imagegen:probe": "tsx --env-file=.env scripts/probeImageGen.mts",
    "fortune:probe": "tsx --env-file=.env scripts/probeFortune.mts",
    "reading:evaluate": "tsx --env-file=.env scripts/evaluateLocalModels.mts --cases=scripts/fixtures/readingComprehensionCases.json --out=docs/evaluations/reading --only=reply",
    "bot-memory:backfill": "tsx --env-file=.env scripts/backfillBotMemory.ts",
    "bot-memory:purge-reactions": "tsx --env-file=.env scripts/purgeReactionBotMemory.ts",
    "tts-pronunciation": "tsx --env-file=.env scripts/manageTtsPronunciations.ts",
    "dev": "pnpm -r dev"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.20.3",
    "@types/node": "^22.15.12",
    "postgres": "^3.4.8",
    "drizzle-orm": "^0.45.1"
  }
}
