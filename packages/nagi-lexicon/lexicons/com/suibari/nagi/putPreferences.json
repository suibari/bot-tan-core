{
  "lexicon": 1,
  "id": "com.suibari.nagi.putPreferences",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "同期対象の本人設定を書き込む。既読位置は単調マージ、配列・言語設定・最後のブックマークフォルダは updatedAt による後勝ち。各項目は省略でき、送った分だけを更新する。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。送らなければ変更しない。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。空文字を送ると登録を解除し、表示名に戻す。送らなければ変更しない。"
            },
            "readPositions": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#readPosition"
              }
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" }
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "emojiFavorites を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#feedTab"
              }
            },
            "feedTabsUpdatedAt": {
              "type": "string",
              "format": "datetime",
              "description": "feedTabs を送るときは必須。保存済みより古ければ書き込まない。"
            },
            "languagePreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "lastBookmarkFolderId": {
              "type": "string",
              "maxLength": 64,
              "nullable": true
            },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readPositions", "emojiFavorites"],
          "properties": {
            "replyFreq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "botたんからの返信確率（0〜100%）。"
            },
            "preferredName": {
              "type": "string",
              "maxLength": 120,
              "maxGraphemes": 40,
              "description": "botたんに呼んでほしい名前。省略時は未設定＝表示名で呼ばれる。"
            },
            "readPositions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#readPosition"
              },
              "description": "マージ後の確定値。送った位置が負けた場合は保存済みの方が返る。"
            },
            "emojiFavorites": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "unknown" }
            },
            "emojiFavoritesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "feedTabs": {
              "type": "array",
              "maxLength": 16,
              "items": {
                "type": "ref",
                "ref": "com.suibari.nagi.getPreferences#feedTab"
              }
            },
            "feedTabsUpdatedAt": { "type": "string", "format": "datetime" },
            "languagePreferences": {
              "type": "ref",
              "ref": "com.suibari.nagi.getPreferences#languagePreferences"
            },
            "languagePreferencesUpdatedAt": {
              "type": "string",
              "format": "datetime"
            },
            "lastBookmarkFolderId": { "type": "string", "maxLength": 64 },
            "lastBookmarkFolderUpdatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }, { "name": "InvalidRequest" }]
    }
  }
}
