{
  "name": "nagi-bot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "analysis": "tsx --env-file=../../.env scripts/runAnalysis.ts",
    "eval:name-intent": "tsx --env-file=../../.env scripts/evalNameIntent.ts",
    "analysis:backfill": "tsx --env-file=../../.env scripts/backfillNagiAnalysis.ts",
    "diary:backfill": "tsx --env-file=../../.env scripts/backfillNagiDiary.ts",
    "diary:activity:backfill": "tsx --env-file=../../.env scripts/backfillDiaryPostCounts.ts",
    "diary:migrate-appview": "tsx --env-file=../../.env scripts/migrateDiariesToAppview.ts",
    "chronicle:backfill": "tsx --env-file=../../.env scripts/backfillNagiChronicle.ts",
    "chronicle:preview": "tsx --env-file=../../.env scripts/previewChronicleMonth.mts",
    "news:feed:preview": "tsx --env-file=../../.env src/newsFeedAdmin.ts preview",
    "news:feed:list": "tsx --env-file=../../.env src/newsFeedAdmin.ts list",
    "news:feed:hide": "tsx --env-file=../../.env src/newsFeedAdmin.ts hide",
    "news:image:backfill": "tsx --env-file=../../.env scripts/backfillNewsImageUrls.ts",
    "zenkatsu:drain": "tsx --env-file=../../.env scripts/drainZenkatsuComments.mts",
    "radio:now": "tsx --env-file=../../.env scripts/generateNagiRadioNow.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.21",
    "@atproto/lexicon": "^0.6.1",
    "@bsky-affirmative-bot/bot-brain": "workspace:*",
    "@bsky-affirmative-bot/bot-runtime": "workspace:*",
    "@bsky-affirmative-bot/clients": "workspace:*",
    "@bsky-affirmative-bot/database": "workspace:*",
    "@bsky-affirmative-bot/nagi-lexicon": "workspace:*",
    "@bsky-affirmative-bot/nagi-linkcard": "workspace:*",
    "@bsky-affirmative-bot/shared-configs": "workspace:*",
    "async-retry": "^1.3.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
